# Build output (rebuild with: python <Mod>/build_<mod>_<ver>.py)
build_classes/
__pycache__/
*.pyc

# Compiled mod jars are build output. Releases get the jar attached instead.
*.jar
# ...except the build tool itself (javassist, Apache-2.0 / MPL / LGPL - redistributable)
!tools/javassist.jar

# NEVER commit game files or other people's mods (not ours to redistribute):
HytaleServer.jar
Assets.zip
UserData/
Mods/

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
backups/
tools/dev/scratch/
# Skyy's reference images (other people's art - local only, never public)
research/refs/
# agent worktrees (Claude Code)
.claude/worktrees/

# Obsidian: the shared vault settings in .obsidian/ ARE committed (app.json, appearance.json, core-plugins.json, bookmarks.json,
# snippets/); per-device window layout, community plugins and the trash are not
.obsidian/workspace*.json
.obsidian/graph.json
.obsidian/plugins/
.obsidian/themes/
.trash/
